{
  "name": "@fitchmultz/pi-ask-question",
  "version": "0.6.4",
  "description": "Pi extension that adds an interactive ask_question tool and /grill-me pressure-test mode",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "extension",
    "ask-question",
    "clarifying-questions",
    "grill-me",
    "custom-tool",
    "tui",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-ask-question.git"
  },
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-ask-question/issues"
  },
  "homepage": "https://github.com/fitchmultz/pi-ask-question#readme",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:agent": "oxlint --deny-warnings --format=agent .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check:compat": "npm run check",
    "check": "npm test && npm run typecheck && npm run format:check && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "24.19.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@12.2.0",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.3"
    }
  }
}
